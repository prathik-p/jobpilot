# Copy to .env and fill in. Never commit .env.
# LLM key: set the one matching scoring.model in config.yaml.
# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Naukri: no password stored. Run `python -m jobpilot login` once and sign in by hand;
# the browser session is saved in data/browser_profile/.

# Telegram digest: create a bot with @BotFather, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email digest (optional). For Gmail use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=

# Optional proxy for LinkedIn scraping, e.g. http://user:pass@host:port
JOBSPY_PROXY=
